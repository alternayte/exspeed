{
  "name": "@exspeed/sdk",
  "version": "0.6.0",
  "description": "TypeScript client for Exspeed (client protocol v2): streams, publishing, durable consumers with push and pull delivery, and ExQL queries",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:e2e": "vitest run test/e2e",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "exspeed",
    "streaming",
    "sdk",
    "client",
    "message-broker",
    "stream-processing"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alternayte/exspeed.git",
    "directory": "sdks/typescript"
  },
  "homepage": "https://github.com/alternayte/exspeed/tree/main/sdks/typescript#readme",
  "bugs": {
    "url": "https://github.com/alternayte/exspeed/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0",
    "@types/node": "^20.0.0"
  }
}
